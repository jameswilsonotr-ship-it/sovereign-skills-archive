# Template only. Copy to Termux private storage and populate through the
# device/operator secret flow. Never commit a populated file.

MCP_BIND=127.0.0.1
MCP_PORT=8081
PHONE_DEVICE_ID=REPLACE_WITH_DEVICE_REGISTRY_ID
LOCAL_RUNNER=litert-lm
LOCAL_MODEL_ID=REPLACE_WITH_APPROVED_GEMMA_MODEL

# Optional Tier B route; keep this on the tailnet and use a secret-managed key.
VULTR_BASE_URL=http://REPLACE_WITH_TAILNET_IP:8000/v1
INFERENCE_API_KEY=REPLACE_WITH_RUNTIME_SECRET_REFERENCE

# Proven SFTP drop target; pin its host key separately.
SFTP_HOST=100.115.0.111
SFTP_PORT=22
SFTP_USER=REPLACE_WITH_OPERATOR_USER
SFTP_HOST_KEY_REF=REPLACE_WITH_PINNED_HOST_KEY_REFERENCE
