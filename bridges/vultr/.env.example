# Template only. Never commit a populated copy of this file.
# VULTR_API_KEY belongs in the provisioning operator's secret store. The
# running inference VPS does not need it.
VULTR_API_KEY=REPLACE_WITH_SECRET_REFERENCE

# Use a short-lived, scoped Tailscale auth key from the secret store.
TS_AUTHKEY=REPLACE_WITH_SECRET_REFERENCE

TAILSCALE_HOSTNAME=mesh-inference-vultr
# cloud-init appends the actual value after `tailscale up`; do not guess it.
TAILSCALE_IP=REPLACE_AT_PROVISION_TIME
MODEL_ID=REPLACE_WITH_APPROVED_MODEL
INFERENCE_IMAGE=vllm/vllm-openai:PIN_A_DIGEST
INFERENCE_API_KEY=REPLACE_WITH_RUNTIME_SECRET_REFERENCE
MAX_MODEL_LEN=4096
HF_HOME=/var/lib/mesh/huggingface
