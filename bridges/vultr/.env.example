# Copy to .env on the inference box. This file is safe to commit only because
# every value below is a placeholder or a local-only default.
TAILNET_IP=__SET_TAILNET_IP__
VULTR_REGION=__VULTR_REGION__
VULTR_INSTANCE_ID=__VULTR_INSTANCE_ID__

# Pull exactly one model first; use a tag supported by the selected Ollama
# release and sized for the VPS RAM/VRAM.
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=5m

# Only required when the `letta` profile is enabled. Use a deployment-only
# random value; do not reuse a Vultr, Tailscale, SSH, or xAI credential.
LETTA_PG_USER=letta
LETTA_PG_PASSWORD=__SET_RANDOM_LETTA_PG_PASSWORD__
LETTA_PG_DB=letta
OLLAMA_API_KEY=ollama

# Optional: compose profile selection for cloud-init or a normal `up`.
# Leave empty for Ollama only; use `letta` to add the Letta server.
COMPOSE_PROFILES=

# Host path to mount for one-shot coder runs. Keep it on the VPS.
CODER_WORKSPACE=__SET_ABSOLUTE_WORKSPACE_PATH__
